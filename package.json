{
  "name": "whynorun",
  "version": "1.0.0",
  "description": "Know what your GitHub Actions workflows will do before you push.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KunalKumarMehta/whynorun.git"
  },
  "type": "module",
  "bin": {
    "whynorun": "dist/whynorun.mjs"
  },
  "files": [
    "dist/whynorun.mjs",
    "dist/THIRD_PARTY_LICENSES.md",
    "schemas/*.schema.json"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite playground",
    "lint": "eslint . && prettier --check .",
    "typecheck": "node scripts/gen-types.mjs && tsc -b",
    "test": "vitest run",
    "build": "node scripts/build.mjs",
    "check:dist": "node scripts/gen-types.mjs && npm run build && { test -z \"$(git status --porcelain --untracked-files=all -- dist/ src/core/generated/)\" || { echo 'dist/ or src/core/generated/ is stale: run `npm ci && npm run typecheck && npm run build` and commit them' >&2; exit 1; }; }",
    "build:playground": "vite build playground",
    "e2e": "npm run build:playground && playwright test"
  },
  "devDependencies": {
    "@actions/expressions": "0.3.61",
    "@actions/workflow-parser": "0.3.61",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "ajv": "^8.20.0",
    "codemirror": "^6.0.2",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "json-schema-to-typescript": "^16.0.0",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "yaml": "^2.9.1"
  }
}
