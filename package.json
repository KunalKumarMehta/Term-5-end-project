{
  "name": "whynorun",
  "version": "0.0.0",
  "description": "Know what your GitHub Actions workflows will do before you push.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KunalKumarMehta/whynorun.git"
  },
  "type": "module",
  "bin": {
    "whynorun": "dist/whynorun.mjs"
  },
  "files": [
    "dist/whynorun.mjs",
    "dist/THIRD_PARTY_LICENSES.md",
    "schemas/*.schema.json"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite playground",
    "lint": "eslint . && prettier --check .",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "build": "node scripts/build.mjs",
    "check:dist": "npm run build && { test -z \"$(git status --porcelain --untracked-files=all -- dist/)\" || { echo 'dist/ is stale: run `npm ci && npm run build` and commit dist/' >&2; exit 1; }; }",
    "build:playground": "vite build playground",
    "e2e": "npm run build:playground && playwright test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
